# Application
APP_ENV=local
IS_PROD=false
PORT=5000

# Database
DB_HOST=localhost
DB_NAME=anote
DB_USER=root
DB_PASSWORD=

# Cache
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=change-me-in-production

# Encrypts user-supplied provider API keys at rest (Settings -> API Usage).
# Falls back to a key derived from JWT_SECRET_KEY if unset — set your own
# in production. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_KEY_ENCRYPTION_KEY=

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Google OAuth (optional) — redirect-based flow. GOOGLE_OAUTH_REDIRECT_URI must
# exactly match an "Authorized redirect URI" on the OAuth client in Google Cloud
# Console; FRONTEND_URL is where the browser lands after login completes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/callback
FRONTEND_URL=http://localhost:3000

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each paid plan tier — required for the "Upgrade plan"
# buttons in Settings > Billing to work. Leave unset to hide a tier.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Storage
UPLOAD_FOLDER=/tmp/anote_uploads
AVATAR_FOLDER=/tmp/anote_avatars
CHROMA_PERSIST_DIR=./chroma_db

# ── Ourogen Coworker ───────────────────────────────────────────────────────────
# Claude model for the coworker agent (needs ANTHROPIC_API_KEY). Without a key
# the coworker runs an offline planner so the demo still works end to end.
COWORKER_MODEL=claude-opus-5-5
COWORKER_EFFORT=medium
# Set to 1 to force the offline planner even when a key is present.
COWORKER_OFFLINE=0
# Optional: run the coworker store on SQLite instead of MySQL (no Docker needed
# for the coworker tables), e.g. sqlite:////tmp/ourogen-coworker.db
COWORKER_DB_URL=
# Public URL of this backend, used to build OAuth redirect URIs.
BACKEND_URL=http://localhost:5000
# Gmail / Calendar / Drive reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# Add this redirect URI to the same OAuth client in Google Cloud Console:
GOOGLE_COWORKER_REDIRECT_URI=http://localhost:5000/api/coworker/connections/google/callback
# Slack OAuth (optional — you can also paste a user token in the app).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# Real-time Slack (Events API). From the Slack app's Basic Information page. Subscribe
# events on behalf of users (message.im, message.mpim, message.channels, message.groups)
# with Request URL <BACKEND_URL>/api/coworker/slack/events. Without it, Slack is polled every minute.
SLACK_SIGNING_SECRET=
# Outlook / Microsoft 365 mail + calendar. Register an app in Entra ID (Azure portal ›
# App registrations), add the web redirect URI below, and create a client secret.
# Delegated Graph permissions: User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read
# Calendars.ReadWrite offline_access. TENANT=common accepts work and personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/coworker/connections/microsoft/callback
# "Continue with Microsoft" sign-in uses the same app; register this redirect URI on it too.
# Defaults to BACKEND_URL + /auth/microsoft/callback.
MICROSOFT_LOGIN_REDIRECT_URI=
# Real-time email. Outlook needs nothing extra: with a public https BACKEND_URL the coworker
# subscribes to inbox notifications itself. Gmail needs a Pub/Sub topic that
# gmail-api-push@system.gserviceaccount.com may publish to, and a push subscription to
# <BACKEND_URL>/api/coworker/google/push?token=<GMAIL_PUSH_TOKEN> (or OIDC auth: set
# GMAIL_PUSH_AUDIENCE to the push endpoint URL and GMAIL_PUSH_SERVICE_ACCOUNT to its account).
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=

# Voice, meetings, and the video twin (all optional; the browser voice is used otherwise)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
RECALL_API_KEY=
RECALL_API_BASE=https://us-east-1.recall.ai/api/v1
# Calls: Recall's low-latency streaming transcription (default) or the platform's captions ("captions").
RECALL_TRANSCRIPT=low_latency
# Model for live calls; empty = the fast sibling of the chosen model (e.g. Haiku for Claude).
COWORKER_CALL_MODEL=
# Seconds of silence that end the other person's turn before the coworker answers.
COWORKER_TURN_SILENCE=0.8
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TWIN_FOLDER=/tmp/ourogen_twin
# Production: store twin files in a private S3 bucket instead of local disk
TWIN_S3_BUCKET=
TWIN_S3_SSE=aws:kms
# With APP_ENV=production the app refuses to start on unsafe settings
# (default JWT secret, no PROVIDER_KEY_ENCRYPTION_KEY, SQLite coworker store).
# ALLOW_UNSAFE_CONFIG=1 overrides that; use it only to recover a broken deploy.
ALLOW_UNSAFE_CONFIG=

# Coworker plans (prices are pilot hypotheses). Gating is off unless set to 1.
COWORKER_ENFORCE_PLANS=0
# Team plan priced per seat in Stripe: keep the subscription quantity equal to members.
COWORKER_TEAM_PER_SEAT=0
STRIPE_PRICE_COWORKER=
STRIPE_PRICE_COWORKER_CALLS=
STRIPE_PRICE_COWORKER_TEAM=

# Founder pilot applications posted by ourogen.ai
PILOT_SLACK_WEBHOOK_URL=
PILOT_BOOKING_URL=
PILOT_ADMIN_EMAILS=

# Approval and digest emails: sent from the user's Gmail when it has send
# access, else through this relay (smtp://user:pass@host:587 or smtps://host:465)
SMTP_URL=
SMTP_FROM=Ourogen <notifications@ourogen.ai>
NOTIFY_BATCH_SECONDS=300
NOTIFY_MIN_INTERVAL_SECONDS=1800
# thread (default): web requests sync on a background thread; worker: coworker-worker does it
COWORKER_SYNC_MODE=thread

# Error tracking (Sentry or compatible) and ops alerts to Slack
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
ALERT_SLACK_WEBHOOK_URL=
# Data retention in days (never below COWORKER_BACKFILL_DAYS)
COWORKER_RETENTION_DAYS=180
COWORKER_TRANSCRIPT_RETENTION_DAYS=180
COWORKER_ACTIVITY_RETENTION_DAYS=730

# HubSpot CRM (optional; users can also paste a private app token pat-...)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
# Salesforce: a Connected App with OAuth scopes "api refresh_token" and callback
# <BACKEND_URL>/api/coworker/connections/salesforce/callback. Sandbox: https://test.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Pipedrive: a Marketplace app with callback <BACKEND_URL>/api/coworker/connections/pipedrive/callback
# (or users paste their personal API token in Settings).
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
